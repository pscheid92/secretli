# Local dev: docker compose up -d && cp .env.example .env && go run . migrate && go run .

# Server
SERVER_PORT=8080

# Database
DATABASE_URL=postgres://secretli:secretli@localhost:5432/secretli?sslmode=disable

# S3 / SeaweedFS
S3_ENDPOINT=localhost:8333
S3_BUCKET=secretli
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_USE_SSL=false
S3_REGION=us-east-1

# Upload limits
MAX_FILE_SIZE=104857600

# Background workers
CLEANUP_INTERVAL=1m

# Metrics
# Set in internet-facing deployments to require Authorization: Bearer <token>
METRICS_TOKEN=

# CORS
ALLOWED_ORIGINS=http://localhost:5173
